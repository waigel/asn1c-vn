# Matches asn1c's own style, so the two read as one codebase.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h}]
indent_style = space
indent_size = 4
max_line_length = 80

[Makefile]
indent_style = tab

[*.asn1]
indent_style = space
indent_size = 4

[*.md]
max_line_length = 80
trim_trailing_whitespace = false
